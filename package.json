{
	"name": "mocks",
	"private": true,
	"version": "0.0.18-beta",
	"type": "module",
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && node scripts/strip-global-props.mjs && vite build",
		"preview": "wrangler dev --port 4173",
		"wrangler:init": "node scripts/wrangler-init.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && node scripts/strip-global-props.mjs && svelte-kit sync && node scripts/theme/check.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"theme:check": "node scripts/theme/check.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --passWithNoTests",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"test:a11y": "playwright test e2e/a11y.e2e.ts",
		"gen": "wrangler types",
		"db:studio": "drizzle-kit studio --config=drizzle.remote.config.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:mocks:local": "wrangler d1 execute DB --local --file=./scripts/seed-mocks.sql",
		"db:seed:mocks:remote": "wrangler d1 execute DB --remote --file=./scripts/seed-mocks.sql",
		"db:seed:demo:local": "wrangler d1 execute DB --local --file=./scripts/seed-demo.sql",
		"content:add": "node scripts/content/sync.ts add",
		"content:update": "node scripts/content/sync.ts update",
		"content:remove": "node scripts/content/sync.ts remove",
		"content:list": "node scripts/content/sync.ts list",
		"content:check": "node scripts/content/check.ts",
		"bank:validate": "node scripts/bank/validate.ts",
		"bank:length-audit": "node scripts/bank/length-audit.ts",
		"bank:link-check": "node scripts/bank/link-check.ts",
		"bank:build": "node scripts/bank/build.ts",
		"bank:seed:local": "node scripts/bank/seed.ts --local",
		"bank:seed:remote": "node scripts/bank/seed.ts --remote",
		"bank:preview:local": "pnpm run bank:seed:local && pnpm run db:publish:exam:local",
		"db:publish:exam:local": "wrangler d1 execute DB --local --file=./scripts/publish-exam-local.sql"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/literata": "^5.3.0",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-cloudflare": "^9.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"@vitest/browser-playwright": "^5.1.2",
		"axe-core": "^4.14.1",
		"bits-ui": "^2.22.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.9",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^1.1.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^4.1.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.74.0",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.4.0",
		"vitest": "^5.1.2",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.168.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#theme/*": "./src/theme/*"
	}
}
